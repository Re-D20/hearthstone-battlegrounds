import jsonschema

GAME_STATE_SCHEMA = {
    "type": "object",
    "properties": {
        "phase": {"type": "string"},
        "players": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {"type": "string"},
                    "health": {"type": "integer"},
                    "board": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {"type": "string"},
                                "attack": {"type": "integer"},
                                "health": {"type": "integer"}
                            },
                            "required": ["id", "attack", "health"]
                        }
                    }
                },
                "required": ["id", "health", "board"]
            }
        }
    },
    "required": ["phase", "players"]
}

def validate_state(state: dict):
    try:
        jsonschema.validate(state, GAME_STATE_SCHEMA)
    except jsonschema.exceptions.ValidationError as e:
        raise ValueError(f"Invalid game state: {e.message}")
